DISCORD_TOKEN=your-bot-token-here
# Optional: set to a guild ID for instant slash-command sync during development
GUILD_ID=755797183902515301
# Optional: set to 1 to also instant-sync commands to GUILD_ID above.
# Leave unset in production — commands sync globally by default, which
# already works in every server the bot is in (just slower to update, up to ~1h).
DEV_INSTANT_SYNC=1
