DISCORD_TOKEN=your-bot-token-here
# Optional: 테스트 서버 ID. [테스트용] 명령어(돈지급, 카드지급)를 쓸 수 있는 서버입니다.
# 명령어 동기화와는 무관합니다 — 봇이 들어가 있는 모든 서버에 재시작 즉시 등록돼요.
GUILD_ID=755797183902515301
# Optional: DB는 이제 서버(길드)마다 data/db/<guild_id>.db 로 분리됩니다.
# 서버별 분리 이전에 쓰던 bazubot.db가 있으면, 이 서버의 DB로 한 번만 옮겨집니다.
# 비워두면 위의 GUILD_ID를 사용합니다.
LEGACY_DB_GUILD_ID=
